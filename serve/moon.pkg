// Serving an ASGI application: the accept loop, workers and reload, and
// HTTP/1.1, HTTP/2, WebSocket and TLS on moonnet connections.
import {
  "moonbitstack/mooncat/config",
  "moonbitstack/mooncat/lifespan",
  "moonbitstack/mooncat/proxy",
  "moonbitstack/moonasgi",
  "moonbitstack/moonhttp/http1",
  "moonbitstack/moonhttp/http2",
  "moonbitstack/moonhttp/hpack",
  "moonbitstack/moonhttp/header",
  "moonbitstack/moonhttp/ws",
  "moonbitstack/moonhttp/upgrade",
  "moonbitstack/moonurl",
  "moonbitstack/moonvar/fixed",
  "moonbitstack/moonlog",
  "moonbitstack/moondate",
  "moonbitstack/moonnet/tcp",
  "moonbitstack/moonbase/base64",
  "moonbitstack/moontls/tls",
  "moonbitstack/mooncred/x509",
  "moonbitlang/async",
  "moonbitlang/async/io",
  "moonbitlang/async/pipe",
  "moonbitlang/async/socket",
  "moonbitlang/async/http",
  "moonbitlang/async/websocket",
  "moonbitlang/async/fs",
  "moonbitlang/async/aqueue",
  "moonbitlang/async/cond_var",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/buffer",
  "moonbitlang/core/deque",
  "moonbitlang/core/cmp",
}

warnings = "-29"

options(
  targets: {
    "extensions_wbtest.mbt": [ "native", "wasm" ],
    "http1.mbt": [ "native", "wasm" ],
    "http1_wbtest.mbt": [ "native", "wasm" ],
    "http2.mbt": [ "native", "wasm" ],
    "http2_test.mbt": [ "native", "wasm" ],
    "http2_wbtest.mbt": [ "native", "wasm" ],
    "process_model.mbt": [ "native", "wasm" ],
    "process_reload.mbt": [ "native", "wasm" ],
    "scope.mbt": [ "native", "wasm" ],
    "server.mbt": [ "native", "wasm" ],
    "server_test.mbt": [ "native", "wasm" ],
    "tls.mbt": [ "native", "wasm" ],
    "tls_wbtest.mbt": [ "native", "wasm" ],
    "websocket.mbt": [ "native", "wasm" ],
    "websocket_frame_wbtest.mbt": [ "native", "wasm" ],
    "websocket_io.mbt": [ "native", "wasm" ],
    "websocket_serve.mbt": [ "native", "wasm" ],
    "websocket_serve_wbtest.mbt": [ "native", "wasm" ],
  },
)
