// 此功能不入文档

// The built-in art: the wordmark in a few alphabets — underscores and slashes,
// blocks, dots and dashes — plus the plain one. They line up under a fixed-width
// font, which is the only place a banner is read. Each block is copied as it was
// drawn: the columns only stay aligned if the spaces are kept.

///|
/// The built-in names, `fast` first: it is what `enable()` alone selects.
let builtin_names : Array[String] = [
  "fast", "shadow", "line", "metric", "cats", "cats2", "fine", "simple",
]

///|
/// The built-in art by name, or `None` for a name that is not one of them.
fn builtin(name : String) -> String? {
  match name {
    "fast" => Some(fast())
    "shadow" => Some(shadow())
    "line" => Some(line())
    "metric" => Some(metric())
    "cats" => Some(cats())
    "cats2" => Some(cats2())
    "fine" => Some(fine())
    "simple" => Some(simple())
    _ => None
  }
}

///|
/// Every built-in name with its art, in the order `names` lists them.
fn all() -> Array[(String, String)] {
  builtin_names.map(name => (name, builtin(name).unwrap_or("")))
}

///|
/// The default: the wordmark slanted, the way a terminal session header reads.
fn fast() -> String {
  let art =
    #|                                           _____ 
    #|_______ __________________________________ __  /_
    #|__  __ `__ \  __ \  __ \_  __ \  ___/  __ `/  __/
    #|_  / / / / / /_/ / /_/ /  / / / /__ / /_/ // /_  
    #|/_/ /_/ /_/\____/\____//_/ /_/\___/ \__,_/ \__/  
    #|                                                 
  art
}

///|
/// Block letters with a double rule along the bottom.
fn shadow() -> String {
  let art =
    #|███╗   ███╗ ██████╗  ██████╗ ███╗   ██╗ ██████╗ █████╗ ████████╗
    #|████╗ ████║██╔═══██╗██╔═══██╗████╗  ██║██╔════╝██╔══██╗╚══██╔══╝
    #|██╔████╔██║██║   ██║██║   ██║██╔██╗ ██║██║     ███████║   ██║   
    #|██║╚██╔╝██║██║   ██║██║   ██║██║╚██╗██║██║     ██╔══██║   ██║   
    #|██║ ╚═╝ ██║╚██████╔╝╚██████╔╝██║ ╚████║╚██████╗██║  ██║   ██║   
    #|╚═╝     ╚═╝ ╚═════╝  ╚═════╝ ╚═╝  ╚═══╝ ╚═════╝╚═╝  ╚═╝   ╚═╝   
    #|                                                                
  art
}

///|
/// The wordmark in slashes, which reads as one stroke rather than as letters.
fn line() -> String {
  let art =
    #|__________________________________________________________________________________________________________        
    #| __________________________________________________________________________________________________________       
    #|  ________________________________________________________________________________________________/\\\______      
    #|   ____/\\\\\__/\\\\\_______/\\\\\________/\\\\\_____/\\/\\\\\\_______/\\\\\\\\__/\\\\\\\\\_____/\\\\\\\\\\\_     
    #|    __/\\\///\\\\\///\\\___/\\\///\\\____/\\\///\\\__\/\\\////\\\____/\\\//////__\////////\\\___\////\\\////__    
    #|     _\/\\\_\//\\\__\/\\\__/\\\__\//\\\__/\\\__\//\\\_\/\\\__\//\\\__/\\\___________/\\\\\\\\\\_____\/\\\______   
    #|      _\/\\\__\/\\\__\/\\\_\//\\\__/\\\__\//\\\__/\\\__\/\\\___\/\\\_\//\\\_________/\\\/////\\\_____\/\\\_/\\__  
    #|       _\/\\\__\/\\\__\/\\\__\///\\\\\/____\///\\\\\/___\/\\\___\/\\\__\///\\\\\\\\_\//\\\\\\\\/\\____\//\\\\\___ 
    #|        _\///___\///___\///_____\/////________\/////_____\///____\///_____\////////___\////////\//______\/////____
  art
}

///|
/// Wide letters, the kind a title screen uses when there is room for them.
fn metric() -> String {
  let art =
    #|      ___           ___           ___           ___           ___           ___                   
    #|     /  /\         /  /\         /  /\         /  /\         /  /\         /  /\          ___     
    #|    /  /::|       /  /::\       /  /::\       /  /::|       /  /::\       /  /::\        /__/\    
    #|   /  /:|:|      /  /:/\:\     /  /:/\:\     /  /:|:|      /  /:/\:\     /  /:/\:\       \  \:\   
    #|  /  /:/|:|__   /  /:/  \:\   /  /:/  \:\   /  /:/|:|__   /  /:/  \:\   /  /::\ \:\       \__\:\  
    #| /__/:/_|::::\ /__/:/ \__\:\ /__/:/ \__\:\ /__/:/ |:| /\ /__/:/ \  \:\ /__/:/\:\_\:\      /  /::\ 
    #| \__\/  /~~/:/ \  \:\ /  /:/ \  \:\ /  /:/ \__\/  |:|/:/ \  \:\  \__\/ \__\/  \:\/:/     /  /:/\:\
    #|       /  /:/   \  \:\  /:/   \  \:\  /:/      |  |:/:/   \  \:\            \__\::/     /  /:/__\/
    #|      /  /:/     \  \:\/:/     \  \:\/:/       |__|::/     \  \:\           /  /:/     /__/:/     
    #|     /__/:/       \  \::/       \  \::/        /__/:/       \  \:\         /__/:/      \__\/      
    #|     \__\/         \__\/         \__\/         \__\/         \__\/         \__\/                  
  art
}

///|
/// Letters with cats' ears and whiskers, drawn with dots and dashes.
fn cats() -> String {
  let art =
    #| _   .-')                                  .-') _            ('-.     .-') _    
    #|( '.( OO )_                               ( OO ) )          ( OO ).-.(  OO) )   
    #| ,--.   ,--.).-'),-----.  .-'),-----. ,--./ ,--,'  .-----.  / . --. //     '._  
    #| |   `.'   |( OO'  .-.  '( OO'  .-.  '|   \ |  |\ '  .--./  | \-.  \ |'--...__) 
    #| |         |/   |  | |  |/   |  | |  ||    \|  | )|  |('-..-'-'  |  |'--.  .--' 
    #| |  |'.'|  |\_) |  |\|  |\_) |  |\|  ||  .     |//_) |OO  )\| |_.'  |   |  |    
    #| |  |   |  |  \ |  | |  |  \ |  | |  ||  |\    | ||  |`-'|  |  .-.  |   |  |    
    #| |  |   |  |   `'  '-'  '   `'  '-'  '|  | \   |(_'  '--'\  |  | |  |   |  |    
    #| `--'   `--'     `-----'      `-----' `--'  `--'   `-----'  `--' `--'   `--'    
  art
}

///|
/// The same idea the other way round, with the letters leaning left.
fn cats2() -> String {
  let art =
    #|<-. (`-')                        <-. (`-')_           (`-')  _ (`-')      
    #|   \(OO )_      .->        .->      \( OO) )_         (OO ).-/ ( OO).->   
    #|,--./  ,-.)(`-')----. (`-')----. ,--./ ,--/ \-,-----. / ,---.  /    '._   
    #||   `.'   |( OO).-.  '( OO).-.  '|   \ |  |  |  .--./ | \ /`.\ |'--...__) 
    #||  |'.'|  |( _) | |  |( _) | |  ||  . '|  |)/_) (`-') '-'|_.' |`--.  .--' 
    #||  |   |  | \|  |)|  | \|  |)|  ||  |\    | ||  |OO )(|  .-.  |   |  |    
    #||  |   |  |  '  '-'  '  '  '-'  '|  | \   |(_'  '--'\ |  | |  |   |  |    
    #|`--'   `--'   `-----'    `-----' `--'  `--'   `-----' `--' `--'   `--'    
  art
}

///|
/// A thin typewriter face, the one a heading in a manual used to be set in.
fn fine() -> String {
  let art =
    #|                                                                      
    #|                                                                      
    #|                                                               ##     
    #| ####m##m   m####m    m####m   ##m####m   m#####m   m#####m  #######  
    #| ## ## ##  ##"  "##  ##"  "##  ##"   ##  ##"    "   " mmm##    ##     
    #| ## ## ##  ##    ##  ##    ##  ##    ##  ##        m##"""##    ##     
    #| ## ## ##  "##mm##"  "##mm##"  ##    ##  "##mmmm#  ##mmm###    ##mmm  
    #| "" "" ""    """"      """"    ""    ""    """""    """" ""     """"  
    #|                                                                      
    #|                                                                      
  art
}

///|
/// The name itself, for a log line that wants a banner and nothing more.
fn simple() -> String {
  let art =
    #|mooncat
  art
}
