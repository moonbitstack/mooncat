// mooncat: a native ASGI 3.0 server (← uvicorn). Rides the moonasgi SEAM over
// moonbitlang/async. Native-only — the async HTTP server has no JS backend.
import {
  "moonbitstack/moonbase/base64",
  "moonbitlang/async",
  "moonbitlang/async/io",
  "moonbitlang/async/pipe",
  "moonbitlang/async/socket",
  "moonbitlang/async/http",
  "moonbitlang/async/websocket",
  "moonbitlang/async/tls",
  "moonbitlang/async/fs",
  "moonbitlang/async/aqueue",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/buffer",
  "moonbitstack/moonasgi",
  "moonbitstack/moonrpc",
}

// moonapi is a test-only dependency: the greet-readiness integration test hosts
// a real moonapi App on mooncat to prove the server half of the greet chain.
// Consumers of mooncat don't inherit it.
import {
  "moonbitstack/moonapi",
} for "test"

// The async TLS-server constructor is `#internal` ("for internal testing
// only") — it is the only server-side TLS entry point the library exposes, and
// its own suite drives HTTPS through it. Opt in to that alert so mooncat can
// serve HTTPS; the single opt-in is documented in README §TLS and tls.mbt.

// -29 (unused_package): `moonbitlang/async/fs` is used only by `process_reload.native.mbt` (the
// native-only `--reload` watcher, whose `@fs.Watcher` has no wasm/js backend), so on the non-native
// targets the import reads as unused. It is genuinely needed on native; suppress the cross-target
// false positive rather than drop a real dependency.

warnings = "-alert_internal-29"
