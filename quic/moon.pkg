// Serving QUIC (RFC 9000): the UDP socket, the datagram loop that routes by connection ID, and
// the timers around moonquic's endpoint, whose connections do their TLS 1.3 handshake on moontls
// (RFC 9001).
//
// A subpackage because of what it costs to carry: moonquic and its TLS are packages a server
// answering HTTP/1.1 and HTTP/2 never touches.
import {
  "moonbitstack/moonquic/conn",
  "moonbitlang/async",
  "moonbitlang/async/socket",
}

// Used only by the whitebox tests, which exercise the frame, packet and
// recovery layers directly against the wire bytes.
import {
  "moonbitstack/moonquic/frame",
  "moonbitstack/moonquic/crypto",
  "moonbitstack/moonquic/recovery",
  "moonbitstack/moonquic/stream",
  "moonbitstack/moonhttp/http3",
  "moonbitstack/moonhttp/header",
  "moonbitstack/mooncrypt/hash/sha2",
  "moonbitstack/mooncred/x509",
  "moonbitstack/moontls/ext",
  "moonbitstack/moontls/keys",
  "moonbitstack/moontls/msg",
  "moonbitstack/mooncrypt/kex/x25519",
  "moonbitstack/mooncrypt/sign/ecdsa",
  "moonbitstack/moonbase/base16",
} for "wbtest"

// The socket and the serving loop are native; on other targets the imports
// they need are unused.

warnings = "-29"
